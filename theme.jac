"""LankaPulse-friendly light and dark design tokens and reusable styles."""

import from "@jac/mobui" { StyleSheet }

glob:pub LIGHT: dict = {
    "bg": "#FFF9F0", "surface": "#FFFFFF", "surfaceWarm": "#FFF0D9",
    "border": "#EEDFCB", "text": "#30251E", "muted": "#847568",
    "accent": "#D98235", "accentDark": "#A95420", "accentText": "#FFFFFF",
    "green": "#52785A", "skeleton": "#F0E7DB"
},
DARK: dict = {
    "bg": "#171A17", "surface": "#222721", "surfaceWarm": "#302A20",
    "border": "#3B4038", "text": "#F5F0E8", "muted": "#B2A99B",
    "accent": "#E39A51", "accentDark": "#F1B36C", "accentText": "#211910",
    "green": "#A6C69B", "skeleton": "#343931"
},
S: dict = {"xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32},
R: dict = {"sm": 12, "md": 16, "lg": 22, "pill": 999},
F: dict = {"xs": 11, "sm": 13, "md": 15, "lg": 18, "xl": 27, "hero": 23};

def:pub buildStyles(C: dict) -> any {
    return StyleSheet.create({
        "screen": {"flex": 1, "backgroundColor": C["bg"]},
        "screenContent": {"paddingTop": 54, "paddingBottom": 36, "paddingHorizontal": 20, "gap": 20},
        "topRow": {"flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "brandRow": {"flexDirection": "row", "alignItems": "center", "gap": 10},
        "brandMark": {"width": 40, "height": 40, "borderRadius": 14, "backgroundColor": C["accent"], "alignItems": "center", "justifyContent": "center"},
        "brandMarkText": {"fontSize": 20, "fontWeight": "bold", "color": C["accentText"]},
        "brand": {"fontSize": F["lg"], "fontWeight": "bold", "color": C["text"]},
        "edition": {"fontSize": F["xs"], "color": C["muted"], "marginTop": 2},
        "savedTop": {"paddingVertical": 9, "paddingHorizontal": 13, "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"]},
        "savedTopActive": {"paddingVertical": 9, "paddingHorizontal": 13, "borderRadius": R["pill"], "backgroundColor": C["accent"]},
        "savedTopText": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["accentDark"]},
        "savedTopTextActive": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["accentText"]},
        "greeting": {"gap": 5},
        "eyebrow": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["accentDark"], "letterSpacing": 1},
        "headline": {"fontSize": F["xl"], "fontWeight": "bold", "lineHeight": 34, "color": C["text"]},
        "subtitle": {"fontSize": F["sm"], "lineHeight": 20, "color": C["muted"]},
        "weatherCard": {"flexDirection": "row", "alignItems": "center", "justifyContent": "space-between", "padding": 16, "borderRadius": R["lg"], "backgroundColor": C["surfaceWarm"]},
        "weatherTitle": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["text"]},
        "weatherMeta": {"fontSize": F["xs"], "color": C["muted"], "marginTop": 4},
        "weatherIcon": {"fontSize": 25, "color": C["accentDark"]},
        "sectionRow": {"flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "sectionTitle": {"fontSize": F["lg"], "fontWeight": "bold", "color": C["text"]},
        "sectionMeta": {"fontSize": F["xs"], "color": C["muted"]},
        "tabs": {"flexDirection": "row", "gap": 9},
        "tab": {"paddingVertical": 10, "paddingHorizontal": 17, "borderRadius": R["pill"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "tabActive": {"paddingVertical": 10, "paddingHorizontal": 17, "borderRadius": R["pill"], "backgroundColor": C["text"]},
        "tabText": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["muted"]},
        "tabTextActive": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["accentText"]},
        "storyList": {"gap": 12},
        "storyCard": {"padding": 16, "gap": 10, "borderRadius": R["lg"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "storyCardSelected": {"padding": 16, "gap": 10, "borderRadius": R["lg"], "backgroundColor": C["surfaceWarm"], "borderWidth": 1, "borderColor": C["accent"]},
        "storyTop": {"flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "category": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["accentDark"]},
        "meta": {"fontSize": F["xs"], "color": C["muted"]},
        "storyTitle": {"fontSize": F["md"], "lineHeight": 22, "fontWeight": "bold", "color": C["text"]},
        "storySummary": {"fontSize": F["sm"], "lineHeight": 20, "color": C["muted"]},
        "storyBottom": {"flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "source": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["muted"]},
        "saveButton": {"paddingVertical": 7, "paddingHorizontal": 11, "borderRadius": R["pill"], "borderWidth": 1, "borderColor": C["border"]},
        "saveButtonActive": {"paddingVertical": 7, "paddingHorizontal": 11, "borderRadius": R["pill"], "backgroundColor": C["accent"]},
        "saveLabel": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["muted"]},
        "saveLabelActive": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["accentText"]},
        "detail": {"padding": 16, "gap": 8, "borderRadius": R["lg"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "detailTitle": {"fontSize": F["lg"], "fontWeight": "bold", "lineHeight": 25, "color": C["text"]},
        "detailBody": {"fontSize": F["sm"], "lineHeight": 22, "color": C["muted"]},
        "detailClose": {"alignSelf": "flex-start", "paddingVertical": 8, "paddingHorizontal": 12, "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"]},
        "detailCloseText": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["accentDark"]},
        "empty": {"alignItems": "center", "padding": 22, "gap": 8, "borderRadius": R["lg"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "emptyTitle": {"fontSize": F["md"], "fontWeight": "bold", "color": C["text"]},
        "emptyText": {"fontSize": F["sm"], "color": C["muted"], "textAlign": "center"},
        "footer": {"alignItems": "center", "paddingTop": 4},
        "footerText": {"fontSize": F["xs"], "color": C["muted"]},
        "previewSection": {"gap": 10},
        "previewLabel": {"fontSize": F["xs"], "fontWeight": "bold", "letterSpacing": 1, "color": C["muted"]},
        "previewRow": {"flexDirection": "row", "alignItems": "center", "gap": 10},
        "previewButton": {"paddingVertical": 11, "paddingHorizontal": 17, "borderRadius": R["md"], "backgroundColor": C["accent"]},
        "previewButtonText": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["accentText"]},
        "previewOutline": {"paddingVertical": 10, "paddingHorizontal": 16, "borderRadius": R["md"], "borderWidth": 1, "borderColor": C["border"], "backgroundColor": C["surface"]},
        "previewOutlineText": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["text"]},
        "previewChip": {"paddingVertical": 7, "paddingHorizontal": 12, "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"]},
        "previewChipText": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["accentDark"]},
        "previewCard": {"padding": 16, "gap": 9, "borderRadius": R["lg"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "skeletonBlock": {"height": 12, "borderRadius": R["pill"], "backgroundColor": C["skeleton"]},
        "skeletonWide": {"height": 15, "width": "84%", "borderRadius": R["pill"], "backgroundColor": C["skeleton"]},
        "skeletonShort": {"height": 10, "width": "56%", "borderRadius": R["pill"], "backgroundColor": C["skeleton"]},
        "themeToggle": {"paddingVertical": 9, "paddingHorizontal": 13, "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"]},
        "categoryScroll": {"marginHorizontal": -20},
        "categoryRow": {"flexDirection": "row", "gap": 8, "paddingHorizontal": 20},
        "categoryChip": {"paddingVertical": 9, "paddingHorizontal": 14, "borderRadius": R["pill"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "categoryChipActive": {"paddingVertical": 9, "paddingHorizontal": 14, "borderRadius": R["pill"], "backgroundColor": C["accent"]},
        "categoryChipText": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["muted"]},
        "categoryChipTextActive": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["accentText"]},
        "feedCard": {"overflow": "hidden", "borderRadius": R["lg"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "thumbnail": {"width": "100%", "height": 160, "backgroundColor": C["surfaceWarm"]},
        "feedCardBody": {"padding": 15, "gap": 9},
        "bookmark": {"minWidth": 38, "minHeight": 38, "alignItems": "center", "justifyContent": "center", "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"]},
        "bookmarkText": {"fontSize": 19, "fontWeight": "bold", "color": C["accentDark"]},
        "feedHeader": {"flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "feedHeadline": {"fontSize": F["md"], "lineHeight": 22, "fontWeight": "bold", "color": C["text"]},
        "loadMore": {"alignItems": "center", "paddingVertical": 13, "paddingHorizontal": 16, "borderRadius": R["md"], "backgroundColor": C["surfaceWarm"]},
        "loadMoreText": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["accentDark"]},
        "refreshButton": {"paddingVertical": 8, "paddingHorizontal": 12, "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"]},
        "refreshText": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["accentDark"]},
        "skeletonCard": {"padding": 12, "gap": 10, "borderRadius": R["lg"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "skeletonImage": {"height": 150, "borderRadius": R["md"], "backgroundColor": C["skeleton"]},
        "detailPanel": {"padding": 16, "gap": 14, "borderRadius": R["lg"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"], "marginTop": 6},
        "detailImage": {"width": "100%", "height": 220, "borderRadius": R["md"], "backgroundColor": C["surfaceWarm"]},
        "detailHeadline": {"fontSize": F["xl"], "lineHeight": 33, "fontWeight": "bold", "color": C["text"]},
        "detailSummary": {"fontSize": F["md"], "lineHeight": 24, "color": C["muted"]},
        "detailActionRow": {"flexDirection": "row", "gap": 10},
        "detailAction": {"flex": 1, "alignItems": "center", "paddingVertical": 13, "paddingHorizontal": 12, "borderRadius": R["md"], "backgroundColor": C["accent"]},
        "detailActionSecondary": {"flex": 1, "alignItems": "center", "paddingVertical": 12, "paddingHorizontal": 12, "borderRadius": R["md"], "backgroundColor": C["surfaceWarm"], "borderWidth": 1, "borderColor": C["border"]},
        "detailActionText": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["accentText"]},
        "detailActionSecondaryText": {"fontSize": F["sm"], "fontWeight": "bold", "color": C["accentDark"]},
        "detailBack": {"paddingVertical": 8, "paddingHorizontal": 13, "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"], "alignSelf": "flex-start"},
        "searchRow": {"flexDirection": "row", "alignItems": "center", "gap": 9, "paddingHorizontal": 14, "borderRadius": R["md"], "backgroundColor": C["surface"], "borderWidth": 1, "borderColor": C["border"]},
        "searchInput": {"flex": 1, "paddingVertical": 12, "fontSize": F["md"], "color": C["text"]},
        "searchIcon": {"fontSize": 17, "color": C["muted"]},
        "recentRow": {"flexDirection": "row", "gap": 8, "flexWrap": "wrap"},
        "recentChip": {"paddingVertical": 7, "paddingHorizontal": 11, "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"]},
        "recentText": {"fontSize": F["xs"], "color": C["accentDark"]},
        "offlineBanner": {"flexDirection": "row", "alignItems": "center", "gap": 8, "paddingVertical": 10, "paddingHorizontal": 13, "borderRadius": R["md"], "backgroundColor": C["surfaceWarm"]},
        "offlineDot": {"width": 8, "height": 8, "borderRadius": R["pill"], "backgroundColor": C["accent"]},
        "offlineText": {"fontSize": F["xs"], "fontWeight": "bold", "color": C["accentDark"]},
        "savedMode": {"paddingVertical": 8, "paddingHorizontal": 12, "borderRadius": R["pill"], "backgroundColor": C["surfaceWarm"]}
    });
}
